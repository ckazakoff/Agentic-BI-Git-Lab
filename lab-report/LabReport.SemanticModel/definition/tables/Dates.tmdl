table Dates
	lineageTag: 00000000-0000-0000-0000-000000000002
	dataCategory: Time

	column Date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 00000000-0000-0000-0000-000000000028
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-000000000029
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	column Month
		dataType: string
		lineageTag: 00000000-0000-0000-0000-00000000002a
		summarizeBy: none
		sortByColumn: 'Month Number'
		isNameInferred
		sourceColumn: [Month]

	column 'Month Number'
		dataType: int64
		formatString: 0
		lineageTag: 00000000-0000-0000-0000-00000000002b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

	column Quarter
		dataType: string
		lineageTag: 00000000-0000-0000-0000-00000000002c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

	partition Dates = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2024, 1, 1), DATE(2025, 12, 31)),
				    "Year", YEAR([Date]),
				    "Month", FORMAT([Date], "mmm"),
				    "Month Number", MONTH([Date]),
				    "Quarter", "Q" & FORMAT([Date], "q")
				)

	annotation PBI_ResultType = Table
